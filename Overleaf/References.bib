@article{GRIFFITH2018109,
title = {Robustly stable adaptive horizon nonlinear model predictive control},
journal = {Journal of Process Control},
volume = {70},
pages = {109-122},
year = {2018},
issn = {0959-1524},
doi = {https://doi.org/10.1016/j.jprocont.2018.07.014},
url = {https://www.sciencedirect.com/science/article/pii/S0959152418301641},
author = {Devin W. Griffith and Lorenz T. Biegler and Sachin C. Patwardhan},
keywords = {Predictive control, Process control, Robust stability, Nonlinear control, Nonlinear programming, Model-based control, Multivariable feedback control},
abstract = {We present a new method for adaptively updating nonlinear model predictive control (NMPC) horizon lengths online via nonlinear programming (NLP) sensitivity calculations. This approach depends on approximation of the infinite horizon problem via selection of terminal conditions, and therefore calculation of non-conservative terminal conditions is key. For this, we also present a new method for calculating terminal regions and costs based on the quasi-infinite horizon framework that extends to large-scale nonlinear systems. This is accomplished via bounds found through simulations under linear quadratic regulator (LQR) control. We show that the resulting controller is Input-to-State practically Stable (ISpS) with a stability constant that depends on the level of nonlinearity in the terminal region. Finally, we demonstrate this approach on a quad-tank system and a large-scale distillation application. Simulation results reveal that the proposed approach is able to achieve significant reduction in average computation time without much loss in the performance with reference to fixed horizon NMPC.}
}

